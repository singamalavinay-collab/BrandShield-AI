# ==============================================================================
# BrandShield AI — Backend Environment Configuration Template
# ==============================================================================
# Usage:
# Copy this file to .env and configure values appropriate for your environment:
#   cp .env.example .env
#
# DO NOT commit .env containing real production secrets or credentials to source control.
# ==============================================================================

# Application Environment
# Options: 'development' | 'staging' | 'production'
ENVIRONMENT=production

# Debug Mode Toggle (Must be false in production)
DEBUG=false

# Service Metadata
PROJECT_NAME=BrandShield AI Backend
VERSION=0.1.0
API_V1_STR=/api/v1

# ==============================================================================
# Cross-Origin Resource Sharing (CORS)
# ==============================================================================
# In production, this MUST be a comma-separated list of secure HTTPS domains.
# Localhost, IP addresses, and HTTP schemes are rejected at startup in production.
# Example: https://app.brandshield.ai,https://brandshield.ai
BACKEND_CORS_ORIGINS=https://app.brandshield.ai,https://brandshield.ai

# ==============================================================================
# Database Configuration
# ==============================================================================
# For Production: Use PostgreSQL with asyncpg driver:
#   Runtime connection (dedicated unprivileged role: brandshield_app):
#     postgresql+asyncpg://brandshield_app:<APP_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?ssl=require
#   Administrative connection for Alembic migrations and DDL (table owner: neondb_owner):
#     postgresql+asyncpg://neondb_owner:<ADMIN_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?ssl=require
# For Local Development / Testing:
#   sqlite+aiosqlite:///brandshield_ai.db
DATABASE_URL=postgresql+asyncpg://brandshield_app:YOUR_SECURE_PASSWORD@postgres:5432/brandshield_ai
MIGRATION_DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_ADMIN_PASSWORD@postgres:5432/brandshield_ai

# Connection Pool Settings (PostgreSQL only)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE=1800

# ==============================================================================
# Authentication & Cryptographic Security
# ==============================================================================
# In production, JWT_SECRET_KEY MUST be overridden with a cryptographically secure,
# randomly generated secret (minimum 256 bits / 32 bytes).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS

# JWT Algorithm (Default: HS256)
JWT_ALGORITHM=HS256

# JWT Access Token Lifespan in minutes (Default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Optional AI Provider Integrations (Semantic Compliance Reasoning)
# ==============================================================================
# Leave blank to operate in deterministic rule-derived mode without external AI dependencies.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro
