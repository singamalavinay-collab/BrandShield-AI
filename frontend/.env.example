# ==============================================================================
# BrandShield AI — Frontend Environment Configuration Template
# ==============================================================================
# Usage:
# Copy this file to .env or .env.production:
#   cp .env.example .env.production
# ==============================================================================

# Backend API Base URL
# Application API functions already include the /api/v1 prefix in their request paths.
# For same-origin / reverse-proxy routing (e.g. unified origin or local Vite proxy):
#   VITE_API_BASE_URL=
# For a separately hosted backend (e.g. decoupled cloud deployment):
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
