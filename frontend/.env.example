# ==============================================================================
# BrandShield AI — Frontend Environment Configuration Template
# ==============================================================================
# Usage:
# Copy this file to .env or .env.production:
#   cp .env.example .env.production
# ==============================================================================

# Backend API Base URL
# For production deployment with reverse proxy (e.g., Nginx serving both at same origin):
#   VITE_API_URL=/api/v1
# For decoupled frontend/backend hosting:
#   VITE_API_URL=https://api.brandshield.ai/api/v1
VITE_API_URL=/api/v1
